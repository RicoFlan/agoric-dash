# --- Postgres (must match your Docker / local instance) ---
# docker-compose maps host 5433 -> container 5432, so the default DSN uses port 5433
DATABASE_URL=postgresql://agoric:agoric@localhost:5433/agoric_dash

# --- Indexer (CometBFT / RPC) ---
RPC_URL=https://main.rpc.agoric.net
# Poll interval, batch size, and lag behind chain head; initial backfill window in blocks
INDEXER_POLL_MS=20000
INDEXER_BATCH=25
INDEXER_LAG=3
INDEXER_INITIAL_WINDOW=500

# --- Optional: CoinGecko (Pro API key) ---
# Used only to enrich *transfer / IBC-related* denoms with optional spot USD in the UI
# (when a denom in src/config/denoms.json has a coingeckoId). Public /simple/price works
# without a key (lower rate limits). Not used for the “Fee paid by denom” list (no USD there).
# COINGECKO_API_KEY=
