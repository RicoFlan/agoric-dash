# --- Postgres (must match your Docker / local instance) ---
# docker-compose maps host 5433 -> container 5432, so the default DSN uses port 5433
DATABASE_URL=postgresql://agoric:agoric@localhost:5433/agoric_dash

# --- Indexer (CometBFT / RPC) ---
# Primary: canonical Agoric archive RPC. RPC_URL_FALLBACK is consulted per-call
# on primary failure (network error, non-2xx, JSON-RPC error, missing result);
# see rpcCallWithFallback in src/lib/rpc.ts. Set both for production resilience.
RPC_URL=https://main-a.rpc.agoric.net
RPC_URL_FALLBACK=https://agoric-rpc.polkachu.com
# Poll interval, batch size, and lag behind chain head.
# Index starts at INDEXER_START_DATE (default 2026-01-01T00:00:00Z).
# Catch-up mode auto-enables when far behind tip.
INDEXER_POLL_MS=20000
INDEXER_BATCH=25
INDEXER_CATCHUP_POLL_MS=100
INDEXER_CATCHUP_BATCH=2000
# Parallel block fetches while far behind tip (each block = block + block_results in parallel too).
INDEXER_CATCHUP_CONCURRENCY=24
INDEXER_CATCHUP_THRESHOLD_BLOCKS=20000
INDEXER_LAG=3
# Retries per block for transient RPC errors (block + block_results).
INDEXER_RPC_RETRIES=6
# Hard lower time boundary for indexed history (UTC ISO datetime).
INDEXER_START_DATE=2026-01-01T00:00:00Z
# Legacy fallback window only used when INDEXER_START_DATE is unset.
INDEXER_INITIAL_WINDOW=1000000

# --- CoinGecko (optional; Demo API key improves free-tier rate limits) ---
# Used for USD estimates: daily prices in denom_price_day (backfill + indexer refresh) and spot fallback.
# COINGECKO_API_KEY=

# --- Daily price refresh (indexer process; keeps denom_price_day current for spot-free USD) ---
# Interval between refreshes (default 6h) and history depth per run (default 3 days, ≤ 365).
# PRICE_REFRESH_MS=21600000
# PRICE_REFRESH_DAYS=3
# Set to 1 to disable the in-indexer refresh (e.g. when a separate cron runs `npm run backfill:prices`).
# PRICE_REFRESH_DISABLED=

# --- scripts/backfillDenomPrices.ts (CLI; additive — never deletes) ---
# History depth (default 365, free-tier max), optional id allowlist, and per-request pause.
# PRICE_BACKFILL_DAYS=365
# PRICE_BACKFILL_IDS=agoric,inter-stable-token
# PRICE_REQUEST_DELAY_MS=2500

# --- scripts/backfillIbcTransferFlowIn.ts & backfillBankCreditsVolume.ts (CLI only) ---
# Skip startup DELETE and only upsert (e.g. resume after a crash with BACKFILL_FROM_HEIGHT).
# Truthy: 1, true, yes (case-insensitive). See script docstrings for BACKFILL_FROM_HEIGHT / BATCH / CONCURRENCY.
# BACKFILL_SKIP_DELETE=1

# --- scripts/scanIbcRecvDay.ts (CLI debugging only; not used by Next.js) ---
# Parallel block fetches when replaying a UTC calendar day for IBC recv totals.
# SCAN_CONCURRENCY=12
# Optional fixed height span (both required together; end height exclusive). Skips RPC time→height search.
# SCAN_HEIGHT_START=
# SCAN_HEIGHT_END_EXCLUSIVE=
