# --- Postgres (must match your Docker / local instance) ---
# docker-compose maps host 5433 -> container 5432, so the default DSN uses port 5433
DATABASE_URL=postgresql://agoric:agoric@localhost:5433/agoric_dash

# --- Indexer (CometBFT / RPC) ---
RPC_URL=https://agoric-rpc.polkachu.com
# Poll interval, batch size, and lag behind chain head.
# Index starts at INDEXER_START_DATE (default 2026-01-01T00:00:00Z).
# Catch-up mode auto-enables when far behind tip.
INDEXER_POLL_MS=20000
INDEXER_BATCH=25
INDEXER_CATCHUP_POLL_MS=100
INDEXER_CATCHUP_BATCH=2000
# Parallel block fetches while far behind tip (each block = block + block_results in parallel too).
INDEXER_CATCHUP_CONCURRENCY=24
INDEXER_CATCHUP_THRESHOLD_BLOCKS=20000
INDEXER_LAG=3
# Hard lower time boundary for indexed history (UTC ISO datetime).
INDEXER_START_DATE=2026-01-01T00:00:00Z
# Legacy fallback window only used when INDEXER_START_DATE is unset.
INDEXER_INITIAL_WINDOW=1000000

# --- CoinGecko (optional; Demo API key improves free-tier rate limits) ---
# Used only for USD spot estimates in the In-tx transfer volume panel.
# COINGECKO_API_KEY=
