{
  "name": "agoric-dash",
  "version": "0.1.0",
  "private": true,
  "description": "Agoric L1 (agoric-3) activity dashboard: indexed metrics and denoms.json display map. See README.md.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:incremental": "next dev --turbopack",
    "dev:webpack": "next dev",
    "dev:clean": "node scripts/dev.mjs",
    "clean": "rm -rf .next",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "smoke": "npm run build && node scripts/smoke-server.mjs",
    "lint": "eslint",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:smoke": "npm run lint && npm run test && npm run build && node scripts/smoke-server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "indexer": "tsx scripts/indexer.ts",
    "reindex:reset": "tsx scripts/reindexReset.ts",
    "scan:ibc-recv-day": "tsx scripts/scanIbcRecvDay.ts",
    "inspect:ibc-recv-tx-events": "tsx scripts/inspectIbcRecvTxEventAmounts.ts",
    "validate:uist-apr2026": "bash scripts/validateUistIbcApril2026.sh",
    "backfill:ibc-flow-in": "tsx scripts/backfillIbcTransferFlowIn.ts",
    "backfill:bank-credits": "tsx scripts/backfillBankCreditsVolume.ts",
    "backfill:prices": "tsx scripts/backfillDenomPrices.ts",
    "backfill:offer-categories": "tsx scripts/backfillOfferCategories.ts",
    "seed:ymax": "tsx scripts/seedYmaxSnapshot.ts",
    "backfill:endblock": "tsx scripts/backfillEndBlock.ts",
    "backfill:provision-pool": "tsx scripts/backfillProvisionPool.ts",
    "backfill:failed-fees": "tsx scripts/backfillFailedTxFees.ts",
    "enumerate:module-accounts": "tsx scripts/enumerateModuleAccounts.ts",
    "parity:rollup": "tsx scripts/verifyRollupParity.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:ensure": "tsx scripts/ensureSchema.ts",
    "check:denom-drift": "tsx scripts/checkDenomDrift.ts",
    "backfill:bundle-installs": "tsx scripts/backfillBundleInstalls.ts"
  },
  "dependencies": {
    "@agoric/cosmic-proto": "^0.5.0",
    "@agoric/rpc": "^0.10.0",
    "@cosmjs/cosmwasm-stargate": "^0.33.1",
    "@cosmjs/encoding": "^0.33.1",
    "@cosmjs/proto-signing": "^0.33.1",
    "@cosmjs/stargate": "^0.33.1",
    "@cosmjs/tendermint-rpc": "^0.33.1",
    "@endo/marshal": "^1.10.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
